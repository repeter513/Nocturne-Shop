# JWT keys (Ed25519 PEM). Путь относительно shop-infra/ (см. корневой README).
# В контейнерах ключи монтируются в /run/jwt/*.pem (JWT_KEYS_DIR на хосте).
JWT_KEYS_DIR=../.shop-keys

# Postgres (суперпользователь для init-скриптов и migrate-all.sh с хоста)
POSTGRES_USER=shop
POSTGRES_PASSWORD=shop
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Проброс портов на хост (UI/API через Envoy — ENVOY_HTTP_PORT)
ADMINER_PORT=8089
ENVOY_HTTP_PORT=8090
ENVOY_GRPC_PORT=8443
ENVOY_ADMIN_PORT=9901
